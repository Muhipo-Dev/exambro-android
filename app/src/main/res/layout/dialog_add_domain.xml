<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.03"
        android:text="@string/admin_add_domain"
        android:textColor="@color/brand_primary_dark"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter hostname or domain (e.g. exam.school.sch.id or cdn.jsdelivr.net)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etNewDomain"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:autofillHints=""
        android:background="@drawable/bg_edit_text"
        android:fontFamily="sans-serif"
        android:hint="exam.example.com"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvDomainError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Please enter a valid domain name."
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAddDomain"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/bg_main"
            android:fontFamily="sans-serif-medium"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmAddDomain"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/brand_accent"
            android:fontFamily="sans-serif-bold"
            android:text="ADD DOMAIN"
            android:textColor="@color/text_white"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
