<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/examRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Navbar Header -->
    <LinearLayout
        android:id="@+id/topNavbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_navy"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- App / School Logo -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo_muhipo" />

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="@string/title_exam_browser"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/school_header"
                android:textColor="@color/brand_gold"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Refresh Page Button -->
        <ImageButton
            android:id="@+id/btnRefreshWeb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_refresh_page"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_white" />

        <!-- Keluar Exam Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitExam"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/danger"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.04"
            android:paddingStart="12dp"
            android:paddingTop="0dp"
            android:paddingEnd="12dp"
            android:paddingBottom="0dp"
            android:text="@string/btn_exit_exam"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- Top Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/bg_button_primary"
        android:visibility="gone"
        tools:progress="60"
        tools:visibility="visible" />

    <!-- Container for WebView & Overlays -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Primary Exam WebView -->
        <WebView
            android:id="@+id/examWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <!-- Offline Screen (Full Overlay) -->
        <LinearLayout
            android:id="@+id/layoutOffline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_wifi_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="@string/offline_title"
                android:textColor="@color/brand_primary_dark"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/offline_desc"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryOffline"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/brand_accent"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/btn_retry"
                android:textColor="@color/text_white"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/text_white" />
        </LinearLayout>

        <!-- Error Screen (Page Failed to Load / Timeout) -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/danger" />

            <TextView
                android:id="@+id/tvErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/error_unable_to_load"
                android:textColor="@color/brand_primary_dark"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvErrorDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="ERR_CONNECTION_TIMED_OUT" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryError"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/brand_accent"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/btn_retry"
                android:textColor="@color/text_white"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/text_white" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
