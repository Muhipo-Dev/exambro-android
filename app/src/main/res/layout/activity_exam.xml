<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/examRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Navbar Header -->
    <LinearLayout
        android:id="@+id/topNavbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_navy"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:minHeight="@dimen/navbar_height"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- App / School Logo -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo_muhipo" />

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="@string/title_exam_browser"
                android:textColor="@color/text_white"
                android:textSize="@dimen/button_text_size" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/school_header"
                android:textColor="@color/brand_gold"
                android:textSize="@dimen/caption_text_size" />
        </LinearLayout>

        <!-- Refresh Page Button -->
        <ImageButton
            android:id="@+id/btnRefreshWeb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_refresh_page"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_white" />

        <!-- Keluar Exam Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitExam"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/danger"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.04"
            android:paddingStart="14dp"
            android:paddingTop="0dp"
            android:paddingEnd="14dp"
            android:paddingBottom="0dp"
            android:text="@string/btn_exit_exam"
            android:textColor="@color/text_white"
            android:textSize="@dimen/caption_text_size"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- Top Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/bg_button_primary"
        android:visibility="gone"
        tools:progress="60"
        tools:visibility="visible" />

    <!-- Container for WebView & Overlays -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Primary Exam WebView -->
        <WebView
            android:id="@+id/examWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <!-- Floating Non-Intrusive Offline / Sync Status Banner -->
        <LinearLayout
            android:id="@+id/layoutCacheBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#E61E293B"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/imgCacheBannerIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/brand_gold" />

            <TextView
                android:id="@+id/tvCacheBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/cache_banner_offline"
                android:textColor="@color/text_white"
                android:textSize="@dimen/subtitle_text_size" />
        </LinearLayout>

        <!-- Offline Screen (Full Overlay with Responsive Centered Content) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutOffline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main"
            android:padding="@dimen/content_padding"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_wifi_off" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="@string/offline_title"
                    android:textColor="@color/brand_primary_dark"
                    android:textSize="@dimen/title_text_size" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/offline_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/body_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryOffline"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/secondary_button_height"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/brand_accent"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="@string/btn_retry"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/button_text_size"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="@color/text_white" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Error Screen (Page Failed to Load / Timeout) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main"
            android:padding="@dimen/content_padding"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/danger" />

                <TextView
                    android:id="@+id/tvErrorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/error_unable_to_load"
                    android:textColor="@color/brand_primary_dark"
                    android:textSize="@dimen/title_text_size" />

                <TextView
                    android:id="@+id/tvErrorDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/body_text_size"
                    tools:text="ERR_CONNECTION_TIMED_OUT" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryError"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/secondary_button_height"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/brand_accent"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/btn_retry"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/button_text_size"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="@color/text_white" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</LinearLayout>
