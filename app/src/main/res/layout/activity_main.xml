<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <!-- Center Container with Responsive Max Width constraint for Tablets and Foldables -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="540dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Active Session Recovery Alert Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/warning_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/warning"
                app:strokeWidth="1.5dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Sesi Ujian Aktif Ditemukan"
                        android:textColor="@color/brand_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvActiveSessionUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="http://192.168.1.100:8080/cbt" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResumeExam"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/warning"
                        android:fontFamily="sans-serif-bold"
                        android:text="LANJUTKAN UJIAN"
                        android:textColor="@color/brand_primary_dark"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_refresh"
                        app:iconGravity="textStart"
                        app:iconTint="@color/brand_primary_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- School Header Badge -->
            <LinearLayout
                android:id="@+id/headerSchool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="@string/school_header"
                    android:textColor="@color/brand_green"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Main App Logo Container -->
            <FrameLayout
                android:id="@+id/logoContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp">

                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/school_header"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_muhipo" />
            </FrameLayout>

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="@string/title_exam_browser"
                android:textColor="@color/brand_navy"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/subtitle_secure_env"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Security Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Security Lock"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/brand_green" />

                <TextView
                    android:id="@+id/tvKioskStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/status_restricted_mode"
                    android:textColor="@color/brand_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Main Interactive Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/text_white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvInstruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/info_scan_instruction"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Primary Action Button: SCAN QR SERVER -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanQr"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:backgroundTint="@color/brand_accent"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="@string/btn_scan_qr"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_qr_scan"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/text_white" />

                    <!-- Secondary Action Button: MANUAL URL / IP (Hidden, accessed via logo tap) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnterUrlManually"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.03"
                        android:text="@string/btn_enter_url_manually"
                        android:textColor="@color/brand_accent"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/brand_accent"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer Section -->
            <TextView
                android:id="@+id/tvAndroidSupport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/info_android_support"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/info_version"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
